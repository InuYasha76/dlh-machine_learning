// List MongoDB Databases, format: | Name padded | Size (3 decimals + GB)

var jsonJSObject = db.adminCommand({ listDatabases: 1 });
var listDatabases = jsonJSObject.databases;

listDatabases.forEach(function (d) {
  var name = d.name;
  var paddedName = (name + "             ").slice(0, 13);

  var dbSize = d.sizeOnDisk / Math.pow(1024, 3);
  dbSize = dbSize.toFixed(3) + "GB";

  print(paddedName + dbSize);
});
